@model IEnumerable<FinanceApp.Models.Expense>

<h1 class="mb-4">Expenses overview</h1>

<div class="container">
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Description</th>
                <th>Amount</th>
                <th>Category</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Amount $</td>
                    <td>@item.Category</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-column flex-md-row align-items-center align-items-md-start mt-4">
    <canvas style="max-width: 450px; max-height:450px;" id="myChart"></canvas>

    <ul id="chartPercentages"
        class="list-unstyled fs-6 mb-0 mt-3 mt-md-5 ms-md-auto me-md-5 p-md-5 text-center text-md-start">
    </ul>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('myChart');
    const percentagesContainer = document.getElementById('chartPercentages');

    fetch('/Expenses/GetChart')
        .then(response => response.json())
        .then(data => {

            const totals = data.map(d => d.total);
            const labels = data.map(d => d.category);
            const sum = totals.reduce((a, b) => a + b, 0);

            labels.forEach((label, index) => {
                const percentage = ((totals[index] / sum) * 100).toFixed(1);

                const li = document.createElement('li');
                li.className = 'd-flex justify-content-between align-items-center py-2 px-3 mb-2 rounded border';

                li.innerHTML = `
                    <span class="text-muted fw-medium me-3">${label} :</span>
                    <span class="fw-semibold fs-5 text-primary ms-3">${percentage}%</span>
                `;

                percentagesContainer.appendChild(li);
            });

            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: totals
                    }]
                }
            });
        });
</script>
